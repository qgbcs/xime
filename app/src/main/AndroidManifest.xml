        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:name=".XimeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xime"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <!-- 主 Activity：接收其他应用分享的 .yaml / .zip 文件 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Xime">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- 启动入口别名 -->
        <activity-alias
            android:name="${applicationId}.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 输入法服务 -->
        <service
            android:name=".service.XimeInputMethodService"
            android:exported="true"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- AI 模型推理服务：独立进程，crash 不影响 IME -->
        <service
            android:name=".service.InferenceService"
            android:exported="false"
            android:process=":inference" />

        <!-- 离线语音识别服务：独立进程，模型推理不占用输入法进程内存 -->
        <service
            android:name=".service.AsrInferenceService"
            android:exported="false"
            android:process=":asr" />

        <!-- 后台采集服务 -->
        <service
            android:name=".service.BackgroundCaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|location|mediaPlayback" />

    </application>

</manifest>